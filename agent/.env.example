# agent/.env — MIMARI §14. Gerçek değerleri agent/.env içine yaz (gitignore'da).

# Zincir
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_RPC_FALLBACK=
AGENT_PRIVATE_KEY=
DEPLOYMENTS_FILE=../deployments/fuji.json

# LLM (F4 Scout)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Döngüler
SCOUT_INTERVAL_SEC=600
SCOUT_MAX_STEPS=12
RESOLVER_INTERVAL_SEC=30
RESOLVE_DELAY_SEC=90
HEDGER_INTERVAL_SEC=300

# Politika
MAX_OPEN_MARKETS=6
SEED_TOTAL=20
CROSSCHECK_MAX_BPS=50

# Hedge (F7)
HEDGE_ENABLED=0
HEDGE_RATIO=0.2
HEDGE_MAX_NOTIONAL=20
HEDGE_MIN_STEP=5
OKX_TR_PROFILE=hackathon

# Sunucu
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:3000
DRY_RUN=0
PAUSE_AGENT=0
DATA_DIR=./data
